Cell[CellGroupData[{

Cell[TextData[{
 "Basic Description",
 Cell[BoxData[
  PaneSelectorBox[{True->
   TemplateBox[{"LongDescription", 
     Cell[
      BoxData[
       FrameBox[
        Cell[
        "Give a short paragraph explaining your paclet. This is the first \
text that users will see when visiting the main landing page of your paclet.",
          "MoreInfoText"], Background -> GrayLevel[0.95], FrameMargins -> 20, 
        FrameStyle -> GrayLevel[0.9], RoundingRadius -> 5, ImageSize -> {
          Scaled[0.65], Automatic}]], "MoreInfoText", Deletable -> True, 
      CellTags -> {"SectionMoreInfoLongDescription"}, 
      CellMargins -> {{66, 66}, {15, 15}}]},
    "MoreInfoOpenerButtonTemplate"]}, Dynamic[
    CurrentValue[
     EvaluationNotebook[], {TaggingRules, "ResourceCreateNotebook"}]],
   ImageSize->Automatic]],ExpressionUUID->
  "5fef62df-749b-42d7-88cf-5508a85a35ec"]
}], "Subsection",
 Editable->False,
 Deletable->False,
 TaggingRules->{"TemplateGroupName" -> "LongDescription"},
 DefaultNewCellStyle->"Text",
 CellTags->{"Basic Description", "LongDescription", "TemplateCellGroup"},
 CellID->1875344653,ExpressionUUID->"763617cf-c755-4b8d-a667-af27e5754f45"],

Cell[TextData[{
 "HTMLPatterns finds elements in HTML imported as an ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["XMLObject", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/XMLObject",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e950d194-938a-4fdd-b4e1-f1e89697de16"],
 " and extracts their text. An ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["XMLPattern", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "a8ffea2d-3e31-41df-88f8-28cb64b7a8ba"],
 " matches an element by its tag, attributes and classes, and by the elements \
below it. ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["XMLCases", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "96307062-654b-47ae-bec9-fc15882d0f09"],
 " and related functions search, test and edit a tree with these patterns. \
They also accept CSS selector strings. ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["HTMLInnerText", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:MaximilienTirard/HTMLPatterns/ref/HTMLInnerText",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "2ce9d228-6933-4f8f-9b8d-2806e6a0bdf8"],
 " gives the readable text of an element, ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["HTMLToNotebook", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:MaximilienTirard/HTMLPatterns/ref/HTMLToNotebook",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ba7abba6-8602-454e-9baa-0174c4d9132b"],
 " converts HTML to a notebook that can be exported to Markdown or PDF, and \
",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["HTMLToTree", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:MaximilienTirard/HTMLPatterns/ref/HTMLToTree",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "92e9bae3-3583-4ed3-ad56-b0eb25728a39"],
 " draws the structure of a tree."
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{4.002625929394176*^9, 4.002625983533663*^9}, {
  4.002626486018412*^9, 4.002626521194654*^9}},
 CellTags->"DefaultContent",
 CellID->300095952,ExpressionUUID->"ce4177b8-7043-43cd-8c2d-bc3020e7b7a2"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Details",
 Cell[BoxData[
  PaneSelectorBox[{True->
   TemplateBox[{"Details", 
     Cell[
      BoxData[
       FrameBox[
        Cell[
        "Details may include a long description of the resource's contents, \
history, methodology or other relevant information. Give references here if \
they are directly relevant to the resource. The details will appear above the \
examples on the webpage for the resource.", "MoreInfoText"], Background -> 
        GrayLevel[0.95], FrameMargins -> 20, FrameStyle -> GrayLevel[0.9], 
        RoundingRadius -> 5, ImageSize -> {
          Scaled[0.65], Automatic}]], "MoreInfoText", Deletable -> True, 
      CellTags -> {"SectionMoreInfoDetails"}, 
      CellMargins -> {{66, 66}, {15, 15}}]},
    "MoreInfoOpenerButtonTemplate"]}, Dynamic[
    CurrentValue[
     EvaluationNotebook[], {TaggingRules, "ResourceCreateNotebook"}]],
   ImageSize->Automatic]],ExpressionUUID->
  "5a27ca6f-6cd6-4401-9e16-928ad37bf48f"]
}], "Subsection",
 Editable->False,
 Deletable->False,
 TaggingRules->{"TemplateGroupName" -> "Details"},
 DefaultNewCellStyle->"Notes",
 CellTags->{"Details", "TemplateCellGroup"},
 CellID->1421062108,ExpressionUUID->"9dbeb263-3c30-4f4b-8f49-0b854688dae4"],

Cell[TextData[{
 "The functions take an ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["XMLObject", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/XMLObject",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "12b9dd41-d7da-420e-98db-9cb090953832"],
 ", an ",
 Cell[BoxData[
  TagBox[
   ButtonBox[
    StyleBox["XMLElement", "SymbolsRefLink",
     ShowStringCharacters->True,
     FontFamily->"Source Sans Pro"],
    BaseStyle->Dynamic[
      FEPrivate`If[
       CurrentValue["MouseOver"], {
       "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
    ButtonData->"paclet:ref/XMLElement",
    ContentPadding->False],
   MouseAppearanceTag["LinkHand"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "abd56d1e-9cb3-4174-b698-7319b1e058e7"],
 ", or a list of elements and strings, such as the result of ",
 Cell[BoxData[
  RowBox[{
   TagBox[
    ButtonBox[
     StyleBox["Import", "SymbolsRefLink",
      ShowStringCharacters->True,
      FontFamily->"Source Sans Pro"],
     BaseStyle->Dynamic[
       FEPrivate`If[
        CurrentValue["MouseOver"], {
        "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
     ButtonData->"paclet:ref/Import",
     ContentPadding->False],
    MouseAppearanceTag["LinkHand"]], "[", 
   RowBox[{
    StyleBox["url", "TI"], ",", 
    RowBox[{"{", 
     RowBox[{
      TagBox[
       ButtonBox[
        StyleBox[
         StyleBox["\"\<HTML\>\"", "FormatsRefLink",
          ShowStringCharacters->True,
          FontFamily->"Source Sans Pro"], "StringTypeLink",
         StripOnInput->False],
        BaseStyle->Dynamic[
          FEPrivate`If[
           CurrentValue["MouseOver"], {
           "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
        ButtonData->"ref/format/HTML",
        ContentPadding->False],
       MouseAppearanceTag["LinkHand"]], ",", "\"\<XMLObject\>\""}], "}"}]}], 
   "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1f6c0304-ad16-45f6-9ac5-aee0d5c945a6"],
 "."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{4.002625994147809*^9, 4.002626001557416*^9}, {
  4.0026265448411827`*^9, 4.002626568514933*^9}},
 CellTags->"DefaultContent",
 CellID->1625210869,ExpressionUUID->"a972eba3-5e4a-4480-a9ea-146f09db2c81"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TagBox[
    ButtonBox[
     StyleBox["XMLPattern", "SymbolsRefLink",
      ShowStringCharacters->True,
      FontFamily->"Source Sans Pro"],
     BaseStyle->Dynamic[
       FEPrivate`If[
        CurrentValue["MouseOver"], {
        "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
     ButtonData->"paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern",
     ContentPadding->False],
    MouseAppearanceTag["LinkHand"]], "[", 
   RowBox[{
    StyleBox["tag", "TI"], ",", 
    StyleBox["attrs", "TI"]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "9afb96a0-d666-4cce-bf6a-2d4de9ed1d6b"],
 " matches an element by its tag and attributes."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{4.002625994147809*^9, 4.002626001557416*^9}, {
  4.0026265448411827`*^9, 4.0026265711339407`*^9}},
 CellTags->"DefaultContent",
 CellID->1180593616,ExpressionUUID->"d721537c-3e00-42af-b150-0eaceab66c4a"],

Cell[TextData[{
 "In ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TagBox[
     ButtonBox[
      StyleBox["XMLPattern", "SymbolsRefLink",
       ShowStringCharacters->True,
       FontFamily->"Source Sans Pro"],
      BaseStyle->Dynamic[
        FEPrivate`If[
         CurrentValue["MouseOver"], {
         "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
      ButtonData->"paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern",
      ContentPadding->False],
     MouseAppearanceTag["LinkHand"]], "[", "\[Ellipsis]", "]"}], "[", 
   RowBox[{
    StyleBox["constraints", "TI"], "\[Ellipsis]"}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "8ee72321-4437-40fc-9e9e-96c1ae585e25"],
 ", constraints test the elements' subtrees. ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    TagBox[
     ButtonBox[
      StyleBox["XMLPattern", "SymbolsRefLink",
       ShowStringCharacters->True,
       FontFamily->"Source Sans Pro"],
      BaseStyle->Dynamic[
        FEPrivate`If[
         CurrentValue["MouseOver"], {
         "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
      ButtonData->"paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern",
      ContentPadding->False],
     MouseAppearanceTag["LinkHand"]], "[", 
    StyleBox["tag", "TI"], "]"}], "[", 
   RowBox[{
    TagBox[
     ButtonBox[
      StyleBox["Child", "SymbolsRefLink",
       ShowStringCharacters->True,
       FontFamily->"Source Sans Pro"],
      BaseStyle->Dynamic[
        FEPrivate`If[
         CurrentValue["MouseOver"], {
         "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
      ButtonData->"paclet:MaximilienTirard/HTMLPatterns/ref/Child",
      ContentPadding->False],
     MouseAppearanceTag["LinkHand"]], "[", 
    StyleBox["p", "TI"], "]"}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "d46fe4cb-c6c5-475b-8a75-df291bfc079d"],
 " matches an element that has an element child matching p, and ",
 Cell[BoxData[
  RowBox[{
   TagBox[
    ButtonBox[
     StyleBox["Descendant", "SymbolsRefLink",
      ShowStringCharacters->True,
      FontFamily->"Source Sans Pro"],
     BaseStyle->Dynamic[
       FEPrivate`If[
        CurrentValue["MouseOver"], {
        "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
     ButtonData->"paclet:MaximilienTirard/HTMLPatterns/ref/Descendant",
     ContentPadding->False],
    MouseAppearanceTag["LinkHand"]], "[", 
   StyleBox["p", "TI"], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "7b506340-6f43-4009-974f-7bc9d9ce3484"],
 " requires a match at any depth. A list pattern such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     TagBox[
      ButtonBox[
       StyleBox["XMLPattern", "SymbolsRefLink",
        ShowStringCharacters->True,
        FontFamily->"Source Sans Pro"],
       BaseStyle->Dynamic[
         FEPrivate`If[
          CurrentValue["MouseOver"], {
          "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
       
       ButtonData->"paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern",
       ContentPadding->False],
      MouseAppearanceTag["LinkHand"]], 
     "[", "\"\<\!\(\*StyleBox[\"li\", \"TI\"]\)\>\"", "]"}], ",", "___"}], 
   "}"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "31af1dc5-4fe2-4863-a022-f365be994297"],
 " matches the element children in order."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{4.002625994147809*^9, 4.002626001557416*^9}, {
   4.0026265448411827`*^9, 4.002626551123423*^9}, {4.0026265902908487`*^9, 
   4.002626670847662*^9}, 4.002627692269073*^9},
 CellTags->"DefaultContent",
 CellID->1286513075,ExpressionUUID->"36d2e6ee-c29c-4ba7-b83b-5e02dbc16f2e"],

Cell[TextData[{
 "Names in a pattern can be bound to elements, attribute values, classes and \
runs of children, and used on the right-hand side of a rule, as in ",
 Cell[BoxData[
  RowBox[{
   TagBox[
    ButtonBox[
     StyleBox["XMLCases", "SymbolsRefLink",
      ShowStringCharacters->True,
      FontFamily->"Source Sans Pro"],
     BaseStyle->Dynamic[
       FEPrivate`If[
        CurrentValue["MouseOver"], {
        "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
     ButtonData->"paclet:MaximilienTirard/HTMLPatterns/ref/XMLCases",
     ContentPadding->False],
    MouseAppearanceTag["LinkHand"]], "[", 
   RowBox[{
    StyleBox["tree", "TI"], ",", 
    RowBox[{
     RowBox[{
      TagBox[
       ButtonBox[
        StyleBox["XMLPattern", "SymbolsRefLink",
         ShowStringCharacters->True,
         FontFamily->"Source Sans Pro"],
        BaseStyle->Dynamic[
          FEPrivate`If[
           CurrentValue["MouseOver"], {
           "Link", FontColor -> RGBColor[0.8549, 0.39608, 0.1451]}, {"Link"}]],
        ButtonData->"paclet:MaximilienTirard/HTMLPatterns/ref/XMLPattern",
        ContentPadding->False],
       MouseAppearanceTag["LinkHand"]], "[", 
      RowBox[{"\"\<\!\(\*StyleBox[\"a\", \"TI\"]\)\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<\!\(\*StyleBox[\"href\", \"TI\"]\)\>\"", "->", 
         StyleBox["url_", "TI"]}], "}"}]}], "]"}], ":>", 
     StyleBox["url", "TI"]}]}], "]"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "440bcc59-fd17-430d-b208-7171d855f35e"],
 "."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{4.002625994147809*^9, 4.002626001557416*^9}, {
   4.0026265448411827`*^9, 4.002626551957102*^9}, 4.0026266807076883`*^9},
 CellTags->"DefaultContent",
 CellID->1851957398,ExpressionUUID->"10932e06-7c89-4c6d-b5cc-b62f38f327c7"],

Cell[TextData[{
 "The key ",
 Cell[BoxData["\"\<\!\(\*StyleBox[\"classList\", \"TI\"]\)\>\""], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "e083b692-28c2-432f-ba11-28471dc626d8"],
 " gives the classes of an element as a list of strings, which a list pattern \
can match."
}], "Notes",
 TaggingRules->{},
 CellChangeTimes->{{4.002625994147809*^9, 4.002626001557416*^9}, {
   4.0026265448411827`*^9, 4.002626552387608*^9}, 4.002626684368431*^9},
 CellTags->"DefaultContent",
 CellID->874595752,ExpressionUUID->"802b7df3-1d2e-4812-a8d4-9c431a83bccb"],

Cell[TextData[{
 "At ",
 Cell[BoxData["\"\<\!\(\*StyleBox[\"classList\", \"TI\"]\)\>\""], 
  "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c99dd814-2c74-4a01-826e-d164cd3c8706"],
 ", a single string matches one class among several: ",
 Cell[BoxData[
  RowBox[{"\"\<\!\(\*StyleBox[\"classList\", \"TI\"]\)\>\"", 
   "->", "\"\<\!\(\*StyleBox[\"active\", \"TI\"]\)\>\""}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "1ef4d937-cab9-4d50-8cfc-31d84ca68c8a"],
 " matches any element that has the class active."
}], "Notes",
